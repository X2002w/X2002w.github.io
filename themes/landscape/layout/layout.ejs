<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= config.description %>">
  <meta name="author" content="<%= config.author %>">
  <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
  <meta property="og:title" content="<% if (is_post()){ %><%= page.title %><% } else { %><%= config.title %><% } %>">
  <meta property="og:url" content="<%= config.url %>/<%= page.path %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <title><% if (is_home()){ %><%= config.title %><% } else if (is_post()){ %><%= page.title %> - <%= config.title %><% } else if (is_archive()){ %>归档 - <%= config.title %><% } else if (is_category()){ %><%= page.category %> - <%= config.title %><% } else if (is_tag()){ %><%= page.tag %> - <%= config.title %><% } else { %><%= page.title %> - <%= config.title %><% } %></title>
  <% if (theme.favicon) { %><link rel="shortcut icon" href="<%= theme.favicon %>"><% } %>
  <% if (config.feed && config.feed.path) { %><link rel="alternate" href="<%- url_for(config.feed.path) %>" title="<%= config.title %>" type="application/atom+xml"><% } %>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #f5edd6;
      --text: #2c2c2c;
      --text-muted: #8a7f60;
      --accent: #7a4d1f;
      --card-bg: #fbf5e6;
      --border: #e0d4ad;
      --radius: 10px;
      --code-bg: #efe4c8;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.8;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    .site-header {
      background: var(--card-bg);
      border-bottom: 1px solid var(--border);
      padding: 0 24px;
      position: sticky; top: 0; z-index: 100;
    }
    .header-inner {
      max-width: 820px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
      height: 56px;
    }
    .site-name { font-size: 1.15rem; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 8px; }
    .site-name:hover { text-decoration: none; color: var(--accent); }
    .site-avatar {
      width: 32px; height: 32px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
    }
    .nav-links { display: flex; gap: 24px; list-style: none; }
    .nav-links a { color: var(--text-muted); font-size: 0.93rem; transition: color 0.2s; }
    .nav-links a:hover { color: var(--accent); text-decoration: none; }

    .site-main { flex: 1; }
    .container { max-width: 820px; margin: 0 auto; padding: 40px 24px; }

    .post-header { margin-bottom: 32px; }
    .post-title { font-size: 1.8rem; font-weight: 700; line-height: 1.3; margin-bottom: 12px; }
    .post-meta { color: var(--text-muted); font-size: 0.9rem; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
    .post-meta a { color: var(--text-muted); }
    .post-body { font-size: 1rem; }
    .post-body h1, .post-body h2, .post-body h3, .post-body h4, .post-body h5, .post-body h6 {
      margin: 1.6em 0 0.6em; font-weight: 700; line-height: 1.3;
    }
    .post-body h1 { font-size: 1.6rem; }
    .post-body h2 { font-size: 1.35rem; border-bottom: 1px solid var(--border); padding-bottom: 6px; }
    .post-body h3 { font-size: 1.15rem; }
    .post-body p { margin: 0.8em 0; }
    .post-body ul, .post-body ol { padding-left: 1.5em; margin: 0.6em 0; }
    .post-body li { margin: 0.3em 0; }
    .post-body img { max-width: 100%; border-radius: var(--radius); margin: 1em 0; }
    .post-body blockquote {
      border-left: 3px solid var(--accent); padding: 8px 16px;
      margin: 1em 0; color: var(--text-muted); background: #efe4c8;
      border-radius: 0 var(--radius) var(--radius) 0;
    }
    .post-body blockquote p { margin: 0.3em 0; }
    .post-body :not(pre) > code {
      background: var(--code-bg); padding: 2px 6px; border-radius: 4px;
      font-size: 0.9em; font-family: "Fira Code", "Cascadia Code", Consolas, monospace;
    }
    .post-body pre {
      background: #1e1e2e; color: #cdd6f4;
      padding: 20px 24px; border-radius: var(--radius);
      overflow-x: auto; margin: 1em 0; line-height: 1.6;
    }
    .post-body pre code { background: none; padding: 0; color: inherit; font-size: 0.88rem; }
    .post-body figure.highlight { margin: 1em 0; border-radius: var(--radius); overflow: hidden; background: #1e1e2e; }
    .post-body figure.highlight table { width: 100%; border-collapse: collapse; }
    .post-body figure.highlight .gutter {
      background: rgba(255,255,255,0.05); color: #6c7086;
      padding: 20px 12px; text-align: right; user-select: none;
      width: 1%; vertical-align: top;
    }
    .post-body figure.highlight .code { padding: 20px 16px; vertical-align: top; }
    .post-body figure.highlight pre { margin: 0; padding: 0; background: none; }
    .post-body table { width: 100%; border-collapse: collapse; margin: 1em 0; }
    .post-body th, .post-body td { border: 1px solid var(--border); padding: 8px 12px; text-align: left; }
    .post-body th { background: #efe4c8; font-weight: 600; }
    .post-body hr { border: none; border-top: 1px solid var(--border); margin: 2em 0; }

    .post-footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--border); }
    .post-tags { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .post-tags .tag-label { color: var(--text-muted); font-size: 0.9rem; }
    .tag-item { display: inline-block; padding: 2px 12px; border: 1px solid var(--border); border-radius: 20px; font-size: 0.85rem; color: var(--text-muted); }
    .tag-item:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

    .post-nav { display: flex; justify-content: space-between; margin-top: 32px; padding-top: 20px; border-top: 1px solid var(--border); }
    .post-nav a { max-width: 48%; font-size: 0.93rem; }

    .article-card {
      background: var(--card-bg); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 24px; margin-bottom: 20px;
      transition: box-shadow 0.2s;
    }
    .article-card:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
    .article-card .card-title { font-size: 1.2rem; font-weight: 600; margin-bottom: 6px; }
    .article-card .card-title a { color: var(--text); }
    .article-card .card-title a:hover { color: var(--accent); text-decoration: none; }
    .article-card .card-meta { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 10px; display: flex; gap: 12px; flex-wrap: wrap; }
    .article-card .card-excerpt { font-size: 0.93rem; color: #555; }

    .archive-year-title { font-size: 1.5rem; font-weight: 700; margin: 32px 0 16px; }
    .archive-year-title:first-child { margin-top: 0; }
    .archive-post-item { display: flex; gap: 16px; padding: 8px 0; align-items: baseline; border-bottom: 1px solid #e8dcbb; }
    .archive-post-item .archive-date { color: var(--text-muted); font-size: 0.88rem; white-space: nowrap; min-width: 90px; }
    .archive-post-item .archive-title { font-size: 0.98rem; }

    .page-nav { display: flex; justify-content: center; gap: 8px; margin-top: 32px; }
    .page-nav a, .page-nav span { display: inline-block; padding: 6px 14px; border-radius: 6px; font-size: 0.9rem; }
    .page-nav a { border: 1px solid var(--border); color: var(--text); }
    .page-nav a:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
    .page-nav .page-number.current { background: var(--accent); color: #fff; }

    .tag-cloud-page { display: flex; flex-wrap: wrap; gap: 8px; }
    .tag-cloud-page a { display: inline-block; padding: 4px 14px; border: 1px solid var(--border); border-radius: 20px; font-size: 0.88rem; color: var(--text-muted); }
    .tag-cloud-page a:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

    .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px; }
    .section-header .section-title { margin-bottom: 0; }

    .heatmap-outer { display: flex; }
    .heatmap-days {
      display: flex; flex-direction: column; gap: 3px;
      flex-shrink: 0; margin-right: 4px; padding-top: 22px;
    }
    .heatmap-days-spacer { height: 0; }
    .heatmap-day-label {
      height: 12px; line-height: 12px;
      font-size: 0.7rem; color: var(--text-muted);
      text-align: right; padding-right: 4px;
    }
    .heatmap-wrapper { position: relative; overflow-x: auto; -webkit-overflow-scrolling: touch; padding-bottom: 8px; }
    .heatmap-wrapper::-webkit-scrollbar { height: 8px; }
    .heatmap-wrapper::-webkit-scrollbar-track { background: transparent; }
    .heatmap-wrapper::-webkit-scrollbar-thumb { background: #d4b483; border-radius: 4px; }
    .heatmap-wrapper::-webkit-scrollbar-thumb:hover { background: #b07d3a; }
    .heatmap-wrapper { scrollbar-width: thin; scrollbar-color: #d4b483 transparent; }
    .heatmap-months {
      position: relative; height: 18px;
      margin-bottom: 4px;
      font-size: 0.72rem; color: var(--text-muted);
    }
    .heatmap-month-label { position: absolute; top: 0; }
    .heatmap-grid { display: flex; flex-direction: column; gap: 3px; }
    .heatmap-row { display: flex; align-items: center; gap: 3px; }
    .heatmap-cell {
      width: 12px; height: 12px;
      border-radius: 2px;
      background: #e8dcbb;
      flex-shrink: 0;
    }
    .heatmap-cell.future { display: none; }
    .heatmap-cell.l1 { background: #d4b483; }
    .heatmap-cell.l2 { background: #b07d3a; }
    .heatmap-cell.l3 { background: #7a4d1f; }
    .heatmap-legend {
      display: flex; align-items: center; justify-content: flex-end; gap: 4px;
      margin-top: 8px; font-size: 0.7rem; color: var(--text-muted);
    }

    .site-footer {
      text-align: center; padding: 32px 24px;
      color: var(--text-muted); font-size: 0.83rem;
      border-top: 1px solid var(--border); margin-top: auto;
    }

    @media (max-width: 640px) {
      .header-inner { flex-direction: column; height: auto; padding: 12px 0; gap: 8px; }
      .nav-links { gap: 16px; }
      .container { padding: 24px 16px; }
      .post-title { font-size: 1.4rem; }
      .archive-post-item { flex-direction: column; gap: 2px; }
      .archive-post-item .archive-date { min-width: 0; }
      .heatmap-cell { width: 10px; height: 10px; }
      .heatmap-row { gap: 2px; }
      .heatmap-grid { gap: 2px; }
      .heatmap-months { font-size: 0.6rem; height: 16px; }
      .heatmap-days { padding-top: 20px; }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="site-name">
        <img class="site-avatar" src="/images/avatar.jpg" alt="avatar" width="32" height="32">
        <%= config.title %>
      </a>
      <nav>
        <ul class="nav-links">
          <li><a href="/">首页</a></li>
          <% if (site.tags.length) { %><li><a href="/tags">标签</a></li><% } %>
          <li><a href="/archives">博客列表</a></li>
          <li><a href="https://github.com/X2002w" target="_blank">GitHub</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="site-main"><%- body %></main>

  <footer class="site-footer">
    &copy; <%= new Date().getFullYear() %> <%= config.author %>.
  </footer>
</body>
</html>
